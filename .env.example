# ========================================================
# TRACKER & ANALYTICS CONFIGURATION
# ========================================================

# 1. Microsoft Clarity (100% GRATIS SELAMANYA)
# Fitur: Heatmap (klik & scroll section), Rekaman video sesi pengunjung (Session Replay),
#        Peta ketertarikan section, deteksi rage clicks / dead clicks, negara & device.
# Cara dapatkan: Buka https://clarity.microsoft.com -> Tambah Proyek -> Salin "Project ID"
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# 2. Google Analytics 4 (Opsional - Dashboard Statistik Google)
# Fitur: Statistik real-time, sumber traffic (Google/LinkedIn/Instagram), demografi.
# Cara dapatkan: Buka https://analytics.google.com -> Buat Properti Web -> Salin "Measurement ID" (G-XXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
